		{% if (!blank_page): %}
			</div>
			</div>
		</div>
		<footer>
			<span>
				Powered by
				<a href="https://www.fanchmwrt.com" target="_blank" rel="noreferrer">FanchmWrt</a>
				/
				<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">
					{{ version.luciname }} ({{ version.luciversion }})</a>
				/
				<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">
					{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
				{% if (lua_active): %}
					/ {{ _('Lua compatibility mode active') }}
				{% endif %}
			</span>
			<ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
		</footer>
		<script>
			// Invalidate cached menu code when the theme is replaced without a firmware build.
			L.env.resource_version = (L.env.resource_version || '') + '-fanchmwrt-icons-20261010-3';
			L.require('menu-fanchmwrt');
		</script>
		{% endif %}
	</body>
</html>
